"""Generated neutral-review renderer for ${BATCH_ID}.

Run inside Blender only after approved geometry builders exist. Camera, scale
reference, lighting, and composition values must come from the batch design or an
approved repository baseline; this template intentionally supplies none.
"""

import argparse
from pathlib import Path


REQUIRED_VIEWS = ("front", "three_quarter", "scale_or_context")


def parse_args():
    parser = argparse.ArgumentParser(description="Render neutral ${BATCH_ID} review evidence")
    parser.add_argument("--input", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    return parser.parse_args()


def configure_approved_view(view_name):
    raise RuntimeError(
        "RAISE_UNTIL_REVIEW_SETUP_APPROVED: configure " + view_name + " from approved review rules"
    )


def main():
    args = parse_args()
    args.output.mkdir(parents=True, exist_ok=True)
    for view_name in REQUIRED_VIEWS:
        configure_approved_view(view_name)
        # Render an actual PNG named for view_name after loading args.input.


if __name__ == "__main__":
    main()
